{
  "name": "fintips",
  "displayName": "FinTips",
  "version": "0.5.0",
  "description": "Motor financeiro pessoal local: o app guarda, aplica e calcula; o agente investiga, pergunta e registra com proveniência. Extrato -> objetos -> causas -> perfil -> triagem, score, projeção e alavancas.",
  "author": {
    "name": "CabriniJr"
  },
  "license": "MIT",
  "keywords": [
    "causas",
    "financas",
    "ofx",
    "open-finance",
    "orcamento",
    "pagbank",
    "perfil"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "fintips": {
      "command": "python",
      "args": [
        "-m",
        "fintips.mcp_server"
      ],
      "env": {
        "FINTIPS_ROOT": "${CLAUDE_PLUGIN_DATA}/workspace",
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  }
}
